# Frontend environment variables for Intervu

# Backend API base URL. In production this MUST point at the deployed backend
# (e.g. https://<your-backend-app>.vercel.app/api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# UI development mode: true = mock responses (no backend required), false = live API
NEXT_PUBLIC_USE_MOCK=false
