# Frontend environment variables for Intervu

# Backend API base URL. Locally: http://localhost:3001/api.
# On Vercel with the monorepo rewrite (vercel.json /api/* -> backend service),
# use the relative path "/api" so requests stay same-origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# UI development mode: true = mock responses (no backend required), false = live API
NEXT_PUBLIC_USE_MOCK=false
