# Frontend environment variables for Intervu

# Backend API base URL.
# Local dev (both servers running): http://localhost:3001/api
# Vercel production: "/api" (relative — vercel.json proxies /api/* to the
# backend service, keeping requests same-origin). NEVER leave empty and NEVER
# use http://localhost here: an empty value makes the production bundle fall
# back to a localhost URL, which the browser blocks ("Failed to fetch").
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# UI development mode: true = mock responses (no backend required), false = live API
NEXT_PUBLIC_USE_MOCK=false
